# Z-Sentinel AI — Environment Configuration Template
# IBM Z Datathon 2026
#
# IMPORTANT: Never commit real API keys or secrets to version control.
# Copy this file to .env for local development or configure these variables in Vercel.

# ----------------------------------------------------
# 1. Groq Cloud AI Configuration (Optional Server-Side)
# ----------------------------------------------------
# Leave empty to run with deterministic local security engine only.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------
# 2. Server Configuration
# ----------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ----------------------------------------------------
# 3. Firebase Web Authentication (Public Client Keys)
# ----------------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Your Apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
