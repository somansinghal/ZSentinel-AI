# Z-SENTINEL AI — BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your secrets

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Optional Groq API Key (Processed ONLY server-side; system operates resiliently if omitted)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# IBM Z Mainframe Target Configuration (Simulated or Real Host)
IBMZ_STREAM_MODE=simulated
IBMZ_HOST=127.0.0.1
IBMZ_PORT=5050
